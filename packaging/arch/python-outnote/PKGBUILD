# Maintainer: craftingDragon7 <info@craftingdragon.ch>
pkgname=python-outnote
_dist=outnote
pkgver=1.3.0
pkgrel=1
pkgdesc='Headless Microsoft 365 client over Graph'
arch=('any')
url='https://github.com/PianoNic/OutNote'
license=('MIT')
depends=('python' 'python-httpx' 'python-ms-entrance')
makedepends=('python-build' 'python-installer' 'python-uv-build')
optdepends=('python-pypdf: PDF text extraction')
source=("https://files.pythonhosted.org/packages/be/95/11f3f99d8696f542b19952a86633e370fe10f0f5631104df1f1413ce9be8/${_dist}-${pkgver}.tar.gz")
sha256sums=('e1a47a190884cfcee07ea7fc69e97b30062b942b4f329aad6fe68d11eab13500')

build() {
  cd "${_dist}-${pkgver}"
  # Upstream pins uv_build <0.12; the current Arch backend also builds this release.
  python -m build --wheel --no-isolation --skip-dependency-check
}

package() {
  cd "${_dist}-${pkgver}"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
